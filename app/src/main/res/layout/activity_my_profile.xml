<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MyProfileActivity">

    <!-- Banner -->
    <TextView
        android:id="@+id/my_profile_header"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/primary_blue"
        android:gravity="center"
        android:text="Mi Perfil"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Flecha regreso -->
    <ImageButton
        android:id="@+id/my_profile_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@null"
        android:contentDescription="Volver"
        android:padding="12dp"
        android:src="@drawable/baseline_arrow_back_ios_24"
        app:tint="@color/white"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@id/my_profile_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Imagen perfil -->
    <ImageView
        android:id="@+id/blank_profile_logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="144dp"
        android:layout_marginTop="32dp"
        android:adjustViewBounds="true"
        android:gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/blank_profile_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/my_profile_header" />

    <!-- Botón editar foto perfil-->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/edit_profile_pic_button"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:padding="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="24dp"
        app:icon="@drawable/twotone_border_color_24"
        app:iconGravity="textStart"
        android:contentDescription="Editar Foto de perfil"
        app:iconPadding="0dp"
        app:iconTint="@color/white"
        app:backgroundTint="@color/primary_blue"
        app:layout_constraintBottom_toBottomOf="@id/blank_profile_logo"
        app:layout_constraintEnd_toEndOf="@id/blank_profile_logo" />

    <!--  Nombre y correo  -->
    <TextView
        android:id="@+id/profile_name"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="Nombre"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/blank_profile_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/profile_email"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="Correo"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/profile_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Contraseña titulo-->
    <TextView
        android:id="@+id/profile_password"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="Contraseña"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/profile_email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Ojo cerrado -->
    <ImageButton
        android:id="@+id/btn_toggle_password_open"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginRight="120dp"
        android:src="@drawable/eye_password_closed"
        android:visibility="gone"
        android:scaleType="fitCenter"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="@id/profile_password"
        app:layout_constraintBottom_toBottomOf="@id/profile_password"/>

    <!-- Ojo abierto -->
    <ImageButton
        android:id="@+id/btn_toggle_password_closed"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginRight="120dp"
        android:src="@drawable/eye_password_open"
        android:scaleType="fitCenter"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="@id/profile_password"
        app:layout_constraintBottom_toBottomOf="@id/profile_password"/>

    <!-- Contraseña -->
    <TextView
        android:id="@+id/tv_profile_password"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="miContraseña123"
        android:textSize="15sp"
        android:inputType="textPassword"
        android:gravity="center"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/profile_password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Recibir alertas -->

    <!-- Boton Switch recibir alertas -->
    <TextView
        android:id="@+id/tv_switch_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Recibir alertas de la aplicación"
        android:textSize="18sp"
        app:layout_constraintEnd_toStartOf="@id/switch_notifications"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_profile_password" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_notifications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tv_switch_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_switch_label"
        app:layout_constraintBottom_toBottomOf="@id/tv_switch_label" />

    <!-- Botón Editar perfil-->
    <Button
        android:id="@+id/edit_profile_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:text="EDITAR PERFIL"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:backgroundTint="@color/primary_blue"
        app:cornerRadius="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switch_notifications" />

</androidx.constraintlayout.widget.ConstraintLayout>