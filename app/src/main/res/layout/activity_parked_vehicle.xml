<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ParkedVehicleActivity"
    android:background="#F7F8FA">

    <!-- Banner -->
    <TextView
        android:id="@+id/parked_vehicle_header"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#0D1B3D"
        android:gravity="center"
        android:text="Mi vehículo estacionado"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/parked_vehicle_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@null"
        android:contentDescription="Volver"
        android:padding="12dp"
        android:src="@drawable/baseline_arrow_back_ios_24"
        app:tint="#FFFFFF"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@id/parked_vehicle_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    
    <TextView
        android:id="@+id/current_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Información actual"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/parked_vehicle_header"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Contenedor información vehículo -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_vehicle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/current_info">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Placa -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_plate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:cardBackgroundColor="#F0F0F0"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/plate_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:text="PLACA"
                    android:textColor="@color/black"
                    android:textSize="20sp"/>

            </androidx.cardview.widget.CardView>

            <!-- Nombre Vehículo y color -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_name_color"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@id/card_plate"
                app:layout_constraintEnd_toStartOf="@id/vehicle_image"
                app:layout_constraintStart_toEndOf="@id/card_plate"
                app:layout_constraintTop_toTopOf="@id/card_plate">

                <!-- LinearLayout interno (Vehiculo y color)-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/vehicle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Vehiculo"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="color"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:gravity="center"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Imagen Vehículo -->
            <ImageView
                android:id="@+id/vehicle_image"
                android:layout_width="100dp"
                android:layout_height="90dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/toyota_corola"
                app:layout_constraintBottom_toBottomOf="@id/card_plate"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/card_plate"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Contenedor Datos Parqueo -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_parking"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_vehicle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Fila 1 -->
            <ImageView
                android:id="@+id/parking_vector"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/parking_vector"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/assigned_space"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Espacio asignado"
                android:layout_marginStart="12dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@id/parking_vector"
                app:layout_constraintBottom_toTopOf="@id/slot_number"
                app:layout_constraintStart_toEndOf="@id/parking_vector"
                app:layout_constraintTop_toTopOf="@id/parking_vector"/>

            <TextView
                android:id="@+id/slot_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:text="Espacio # 0000"
                app:layout_constraintStart_toEndOf="@id/parking_vector"
                app:layout_constraintTop_toBottomOf="@id/assigned_space" />

            <!-- Fila 2 -->
            <ImageView
                android:id="@+id/icon_time"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/parking_vector"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/slot_number" />

            <TextView
                android:id="@+id/lbl_entry_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Hora de ingreso"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintStart_toEndOf="@id/icon_time"
                app:layout_constraintTop_toTopOf="@id/icon_time" />

            <TextView
                android:id="@+id/val_entry_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="23/09/2026 - 10:30 AM"
                android:textColor="@color/black"
                android:textSize="17sp"
                app:layout_constraintStart_toEndOf="@id/icon_time"
                app:layout_constraintTop_toBottomOf="@id/lbl_entry_time" />

            <!-- Fila 3 -->
            <ImageView
                android:id="@+id/icon_timer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/parking_vector"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/val_entry_time" />

            <TextView
                android:id="@+id/lbl_elapsed_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Tiempo transcurrido"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintStart_toEndOf="@id/icon_timer"
                app:layout_constraintTop_toTopOf="@id/icon_timer" />

            <TextView
                android:id="@+id/val_elapsed_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="02:15:45"
                android:textColor="@color/black"
                android:textSize="17sp"
                app:layout_constraintStart_toEndOf="@id/icon_timer"
                app:layout_constraintTop_toBottomOf="@id/lbl_elapsed_time" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Botón ver ubicación-->
    <Button
        android:id="@+id/location_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VER UBICACIÓN DEL ESPACIO"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:backgroundTint="#F5B400"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/card_parking"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Botón Registrar salida-->
    <Button
        android:id="@+id/exit_view_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REGISTRAR SALIDA"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:backgroundTint="#28A745"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/location_button"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>