<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegisterExitActivity"
    android:background="#F7F8FA">

    <!-- Banner -->
    <TextView
        android:id="@+id/parked_vehicle_header"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#0D1B3D"
        android:gravity="center"
        android:text="Registrar salida"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/parked_vehicle_out_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@null"
        android:contentDescription="Volver"
        android:padding="12dp"
        android:src="@drawable/baseline_arrow_back_ios_24"
        app:tint="#FFFFFF"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@id/parked_vehicle_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/sumary_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Resumen del parqueo"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/parked_vehicle_header"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Contenedor información vehículo -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_vehicle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sumary_info">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Placa -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_plate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:cardBackgroundColor="#F0F0F0"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/plate_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:text="PLACA"
                    android:textColor="@color/black"
                    android:textSize="20sp"/>

            </androidx.cardview.widget.CardView>

            <!-- Nombre Vehículo y color -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_name_color"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@id/card_plate"
                app:layout_constraintEnd_toStartOf="@id/vehicle_image"
                app:layout_constraintStart_toEndOf="@id/card_plate"
                app:layout_constraintTop_toTopOf="@id/card_plate">

                <!-- LinearLayout interno (Vehiculo y color)-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/vehicle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Vehiculo"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="color"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:gravity="center"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Imagen Vehículo -->
            <ImageView
                android:id="@+id/vehicle_image"
                android:layout_width="100dp"
                android:layout_height="90dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/toyota_corola"
                app:layout_constraintBottom_toBottomOf="@id/card_plate"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/card_plate"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Contenedor Resumen del Parqueo -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_parking_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_vehicle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Fila 1 -->
            <ImageView
                android:id="@+id/icon_entry_time"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/parking_vector"
                app:layout_constraintBottom_toBottomOf="@id/lbl_entry_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/lbl_entry_time" />

            <TextView
                android:id="@+id/lbl_entry_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Hora de ingreso"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/icon_entry_time"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/val_entry_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23/09/2026 - 10:30 AM"
                android:textColor="@color/black"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/lbl_entry_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/lbl_entry_time" />

            <!-- Fila 2 -->
            <ImageView
                android:id="@+id/icon_exit_time"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/parking_vector"
                app:layout_constraintBottom_toBottomOf="@id/lbl_exit_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/lbl_exit_time" />

            <TextView
                android:id="@+id/lbl_exit_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="20dp"
                android:text="Hora de salida"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/icon_exit_time"
                app:layout_constraintTop_toBottomOf="@id/lbl_entry_time" />

            <TextView
                android:id="@+id/val_exit_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23/09/2026 - 5:30 PM"
                android:textColor="@color/black"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/lbl_exit_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/lbl_exit_time" />

            <!-- Fila 3 -->
            <ImageView
                android:id="@+id/icon_total_time"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/parking_vector"
                app:layout_constraintBottom_toBottomOf="@id/lbl_total_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/lbl_total_time" />

            <TextView
                android:id="@+id/lbl_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="20dp"
                android:text="Tiempo total"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/icon_total_time"
                app:layout_constraintTop_toBottomOf="@id/lbl_exit_time" />

            <TextView
                android:id="@+id/val_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7:00:45"
                android:textColor="@color/black"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="@id/lbl_total_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/lbl_total_time" />

            <!-- Fila 4 -->
            <ImageView
                android:id="@+id/icon_payment"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/parking_vector"
                app:layout_constraintBottom_toBottomOf="@id/lbl_payment"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/lbl_payment" />

            <TextView
                android:id="@+id/lbl_payment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="20dp"
                android:text="Valor a pagar"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/icon_payment"
                app:layout_constraintTop_toBottomOf="@id/lbl_total_time" />

            <TextView
                android:id="@+id/val_payment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 8.000"
                android:textColor="#28A745"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/lbl_payment"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/lbl_payment" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Botón confirmar-->
    <Button
        android:id="@+id/confirm_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="CONFIRMAR SALIDA"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:backgroundTint="#28A745"
        app:cornerRadius="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_parking_summary" />

</androidx.constraintlayout.widget.ConstraintLayout>