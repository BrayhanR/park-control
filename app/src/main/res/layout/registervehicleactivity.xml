<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ENCABEZADO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@color/primary_blue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <Button
                android:id="@+id/btnRegresar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:backgroundTint="@color/primary_blue"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Registrar vehículo"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgPlaca"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_margin="50dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

        </LinearLayout>
        <!-- FOTO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnCamara"
                android:layout_width="180dp"
                android:layout_height="50dp"
                android:backgroundTint="@color/primary_blue"
                android:textColor="@color/white"
                android:text="Agregar foto"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- PLACA -->

        <EditText
            android:id="@+id/txtPlaca"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@color/white"
            android:textColorHint="@color/clear_grey"
            android:textColor="@color/black"
            android:hint="Placa del vehículo"
            android:inputType="textCapCharacters"
            android:padding="15dp" />

        <!-- TIPO -->

        <Spinner
            android:id="@+id/spinnerTipo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp" />

        <!-- MARCA -->

        <EditText
            android:id="@+id/txtMarca"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@color/white"
            android:textColorHint="@color/clear_grey"
            android:textColor="@color/black"
            android:hint="Marca"
            android:inputType="textCapSentences"
            android:padding="15dp" />

        <!-- COLOR -->

        <EditText
            android:id="@+id/txtColor"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@color/white"
            android:textColorHint="@color/clear_grey"
            android:textColor="@color/black"
            android:hint="Color"
            android:inputType="textCapSentences"
            android:padding="15dp" />

        <!-- GUARDAR -->

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_margin="20dp"
            android:backgroundTint="@color/primary_blue"
            android:text="GUARDAR VEHÍCULO"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <!-- TÍTULO Y TABLA DE VEHÍCULOS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:text="Vehículos Registrados"
            android:textColor="@color/primary_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <!-- ENCABEZADO DE LA TABLA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary_blue"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text="ID"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Placa"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Tipo"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Marca"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Color"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- RECYCLERVIEW PARA CONTENER LAS FILAS DE LA BASE DE DATOS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVehiculos"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/white"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imgParkControlLogo"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Ilustración de parqueadero"
            android:scaleType="fitCenter"
            android:src="@drawable/parkcontrol" />

    </LinearLayout>

</ScrollView>